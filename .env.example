# ============================================================
# Variables de entorno de Brand Solutions
# Copiá este archivo como .env.local y completá los valores.
# ============================================================

# Endpoint que recibe los envíos de los formularios
# (lead magnet, newsletter y contacto).
# Puede ser el webhook de tu plataforma de email marketing,
# un formulario de terceros o un endpoint propio.
# Si se deja vacío, los formularios simulan el envío.
NEXT_PUBLIC_FORM_ENDPOINT=

# URL base del checkout o de la plataforma de cursos.
# Los botones de compra agregan ?tipo=curso&item=<slug>.
# Si se deja vacío, los botones llevan al formulario de contacto.
NEXT_PUBLIC_CHECKOUT_URL=
