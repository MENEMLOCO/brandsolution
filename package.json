{
  "name": "brand-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de Brand Solutions — formacion en Marketing Digital e Inteligencia Artificial.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:html": "esbuild tools/build.mjs --bundle --platform=node --format=esm --outfile=.tmp/build.mjs --packages=external --jsx=automatic --log-level=warning && node .tmp/build.mjs && tailwindcss -i .tmp/tailwind-input.css -o html/assets/css/styles.css --minify"
  },
  "dependencies": {
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}